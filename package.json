{
  "name": "pico-monorepo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm --filter @alivault/pico dev",
    "build": "pnpm --filter @alivault/pico build",
    "start": "pnpm --filter @alivault/pico start",
    "test": "pnpm --filter @alivault/pico test",
    "check": "pnpm --filter @alivault/pico check",
    "release": "pnpm --filter @alivault/pico release",
    "website:dev": "pnpm --filter @pico/website run dev",
    "website:deploy": "pnpm --filter @pico/website run deploy"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.33.0"
}
