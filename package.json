{
  "name": "@alivault/pico",
  "version": "0.14.1",
  "description": "A local workspace for Pi coding-agent sessions with browser, macOS, and iOS clients.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "pico-app": "bin/pico.mjs"
  },
  "files": [
    ".output/public",
    "bin",
    "public/screenshots",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alivault/pico.git"
  },
  "homepage": "https://github.com/alivault/pico#readme",
  "bugs": {
    "url": "https://github.com/alivault/pico/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pico": {
    "serverProtocolVersion": 2,
    "apiContractVersion": 1
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "vp build && node ./scripts/check-static-spa.mjs",
    "start": "node ./bin/pico.mjs",
    "rust:check": "cargo test --workspace",
    "rust:server": "cargo run -p pico-server -- serve",
    "rust:pi-smoke": "cargo run -p pico-server -- pi-smoke",
    "fetch:pi-standalone": "node ./scripts/fetch-pi-standalone.mjs",
    "build:pi-bridge": "node ./scripts/build-pi-bridge.mjs",
    "package:macos": "node ./scripts/package-macos.mjs",
    "package:native": "node ./scripts/package-native-release.mjs",
    "prepack": "pnpm build",
    "preview": "vp preview",
    "lint": "vp lint",
    "format": "vp fmt",
    "check:contracts": "node ./scripts/check-contract-fixtures.mjs",
    "check:native-cutover": "node ./scripts/check-native-cutover.mjs",
    "check:native-launcher": "node ./scripts/check-native-launcher.mjs",
    "check:native-packaging": "node ./scripts/check-native-packaging.mjs",
    "check": "vp check && pnpm check:contracts && pnpm check:native-cutover && pnpm check:native-launcher && pnpm check:native-packaging && cargo test --workspace",
    "check:fix": "vp check --fix && pnpm check:contracts && pnpm check:native-cutover && pnpm check:native-launcher && pnpm check:native-packaging && cargo test --workspace",
    "release": "node ./scripts/release.mjs",
    "update:pi": "pnpm update @earendil-works/pi-coding-agent --latest"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.0",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@pierre/diffs": "^1.1.20",
    "@pierre/trees": "1.0.0-beta.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/pacer": "^0.21.0",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/router-plugin": "^1.166.13",
    "@tanstack/store": "^0.11.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun": "1.3.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "react-scan": "^0.5.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.33.0"
}
