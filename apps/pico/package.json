{
  "name": "@alivault/pico",
  "version": "1.2.0",
  "description": "A local browser workspace for durable Pi coding-agent sessions.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "pico-app": "bin/pico.mjs"
  },
  "files": [
    ".output/public",
    "server/dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alivault/pico.git",
    "directory": "apps/pico"
  },
  "homepage": "https://github.com/alivault/pico#readme",
  "bugs": {
    "url": "https://github.com/alivault/pico/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pico": {
    "serverProtocolVersion": 3,
    "apiContractVersion": 1
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "vp build && node ./scripts/check-static-spa.mjs && pnpm --filter @pico/server build",
    "build:web": "vp build && node ./scripts/check-static-spa.mjs",
    "build:server": "pnpm --filter @pico/server build",
    "start": "node ./bin/pico.mjs",
    "test": "pnpm --filter @pico/server test",
    "check:smoke": "node ./scripts/check-browser-smoke.mjs",
    "prepack": "node -e \"for (const f of ['README.md','LICENSE']) require('fs').copyFileSync('../../'+f, f)\" && pnpm build",
    "preview": "vp preview",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check && node ./scripts/check-api-urls.mjs && pnpm --filter @pico/server typecheck && pnpm test",
    "check:fix": "vp check --fix && node ./scripts/check-api-urls.mjs && pnpm --filter @pico/server typecheck && pnpm test",
    "release": "node ./scripts/release.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@pierre/diffs": "^1.1.20",
    "@pierre/trees": "1.0.0-beta.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/pacer": "^0.21.0",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/router-plugin": "^1.166.13",
    "@tanstack/store": "^0.11.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.59.0",
    "mermaid": "^12.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "react-scan": "^0.5.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "croner": "9.1.0",
    "playwright-core": "1.64.0",
    "shiki": "4.5.0",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0",
    "web-push": "3.6.7",
    "ws": "8.21.3"
  }
}
