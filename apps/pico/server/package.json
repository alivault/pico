    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "croner": "9.1.0",
    "pi-web-access": "0.44.0",
    "playwright-core": "1.64.0",
    "shiki": "4.5.0",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0",
    "web-push": "3.6.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
