{
  "name": "@pico/server",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "dev": "node ./build.mjs --watch",
    "start": "node ./dist/pico-server.mjs serve",
